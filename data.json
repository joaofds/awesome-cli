  "Conteinerização": {
    "Docker": {
      "Copy file": {
        "Description": "Copy a file to inside container",
        "Command": "docker cp ~/adagio.backup \"$(docker-compose ps -q postgresql)\":/home/adagio.backup\ndocker cp /home/joaofds/adagio.psql postgres11.7:/home/adagio.sql"
      },
      "Show Logs": {
        "Description": "Show real time container logs",
        "Command": "docker logs --tail 50 --follow --timestamps container_name"
      },
      "MySQL Backup": {
        "Description": "MySQL backup containers database",
        "Command": "docker exec CONTAINER /usr/bin/mysqldump -u root --password=root DATABASE > backup.sql"
      },
      "MySQL Restore Backup": {
        "Description": "MySQL restore database to container",
        "Command": "cat backup.sql | docker exec -i CONTAINER /usr/bin/mysql -u root --password=root DATABASE"
      },
      "PostgreSQL Backup": {
        "Description": "PostgreSQL backup containers database",
        "Command": "docker exec -t your-db-container pg_dumpall -c -U postgres > dump_`date +%d-%m-%Y\"_\"%H_%M_%S`.sql"
      },
      "PostgreSQL Restore Backup": {
        "Description": "Restore database in container",
        "Command": "cat your_dump.sql | docker exec -i your-db-container psql -U postgres"
      },
      "PostgreSQL Restore pgdump": {
        "Description": "PostgreSQL restore pdgump file",
        "Command": "docker exec -i <container> pg_restore -U postgres -d <db_name> < ./filename.pgdump"
      },
      "PostgreSQL Backup pgdump": {
        "Description": "Backup do banco PostgreSQL usando pg_dump em container Docker",
        "Command": "docker exec -i postgres-postgres-1 pg_dump -U postgres -d portalis_prod -Fc > portalis_prod.pgdump --verbose"
      }
    },
    "Docker Compose": {
      "Up Containers": {
        "Description": "Up all containers and services",
        "Command": "docker-compose up -d"
      },
      "Down Containers": {
        "Description": "Down all containers and services",
        "Command": "docker-compose down"
      }
    }
  },
  "Banco de Dados": {
    "PostgreSQL": {
      "Conectar via psql": {
        "Description": "Conectar ao banco via terminal",
        "Command": "psql -h host -U usuario -d banco"
      },
      "Listar Bancos": {
        "Description": "Listar bancos de dados",
        "Command": "\\l"
      },
      "Listar Tabelas": {
        "Description": "Listar tabelas do banco",
        "Command": "\\dt"
      },
      "Backup Completo": {
        "Description": "Backup completo do banco",
        "Command": "pg_dump -U usuario -h host -F c -b -v -f arquivo.backup banco"
      },
      "Restaurar Backup": {
        "Description": "Restaurar backup gerado pelo pg_dump",
        "Command": "pg_restore -U usuario -d banco -v arquivo.backup"
      },
      "Exportar Dados": {
        "Description": "Exportar dados de uma tabela para CSV",
        "Command": "COPY tabela TO 'arquivo.csv' DELIMITER ',' CSV HEADER;"
      },
      "Importar Dados": {
        "Description": "Importar dados de CSV para tabela",
        "Command": "COPY tabela FROM 'arquivo.csv' DELIMITER ',' CSV HEADER;"
      },
      "PGDump Host Backup": {
        "Description": "Faz backup de banco de um host IP",
        "Command": "pg_dump -h 192.168.x.x -U sgc -p 5432 -f bkp.sql -F c nome_do_banco"
      }
    },
    "MySQL": {
      "Conectar via mysql": {
        "Description": "Conectar ao banco via terminal",
        "Command": "mysql -u usuario -p -h host banco"
      },
      "Listar Bancos": {
        "Description": "Listar bancos de dados",
        "Command": "SHOW DATABASES;"
      },
      "Listar Tabelas": {
        "Description": "Listar tabelas do banco",
        "Command": "SHOW TABLES;"
      },
      "Backup Completo": {
        "Description": "Backup completo do banco",
        "Command": "mysqldump -u usuario -p banco > backup.sql"
      },
      "Restaurar Backup": {
        "Description": "Restaurar backup do banco",
        "Command": "mysql -u usuario -p banco < backup.sql"
      },
      "Exportar Dados": {
        "Description": "Exportar dados de uma tabela para CSV",
        "Command": "SELECT * FROM tabela INTO OUTFILE '/tmp/tabela.csv' FIELDS TERMINATED BY ',' ENCLOSED BY '\"' LINES TERMINATED BY '\n';"
      },
      "Importar Dados": {
        "Description": "Importar dados de CSV para tabela",
        "Command": "LOAD DATA INFILE '/tmp/tabela.csv' INTO TABLE tabela FIELDS TERMINATED BY ',' ENCLOSED BY '\"' LINES TERMINATED BY '\n';"
      }
    }
  },
